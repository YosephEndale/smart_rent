# Database Configuration
DB_HOST=localhost
DB_NAME=rent_web
DB_USER=root
DB_PASS=yourpassword

# External APIs
# Fixer.io API for currency exchange rates
# Get your API key from https://fixer.io/
FIXER_API_KEY=your_fixer_api_key_here

# OpenRouter API for chatbot functionality
# Get your API key from https://openrouter.ai/
OPENROUTER_API_KEY=your_openrouter_api_key_here

# OpenRouter API key for scoring (can be same as OPENROUTER_API_KEY)
# Used for tenant application scoring in UserLogic
OPENROUTER_API_KEY_SCORING=your_openrouter_api_key_here

# Google API key for property-related services (Maps, Geocoding, etc.)
# Get your API key from https://console.cloud.google.com/
GOOGLE_API_KEY=your_google_api_key_here

# Encryption Key (base64 encoded 32-byte key for AES-256-CBC)
# Generate with: openssl rand -base64 32
ENCRYPTION_KEY=your_base64_encoded_encryption_key_here
